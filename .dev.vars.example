# Copy to .dev.vars and fill in. .dev.vars is git-ignored and holds local secrets
# (same convention as the ERP). getCloudflareContext() surfaces these in `next dev`.

# Direct Supabase pooler URL (session pooler / port 5432) for local dev + drizzle
# migrations. Enter it here directly — never paste it into chat. Point it at the
# COMPANY Supabase project; Connect uses the `connect` schema so it won't collide
# with the ERP's public tables.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# DEMO stubs WhatsApp (no Meta needed). LIVE sends/receives via the Cloud API.
WHATSAPP_MODE="DEMO"

# --- Required only when WHATSAPP_MODE=LIVE (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=""            # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=""  # the WABA phone number id
WHATSAPP_VERIFY_TOKEN=""     # any secret; must match Meta's webhook config
# Webhook callback URL to register in Meta: https://<host>/api/webhooks/whatsapp

# Shared secrets for POST /api/webhooks/erp and /api/webhooks/driver. Callers send
# `x-connect-key: <secret>`. Left empty, the endpoints are open only while
# WHATSAPP_MODE=DEMO and refuse every call otherwise.
ERP_WEBHOOK_SECRET=""
DRIVER_WEBHOOK_SECRET=""

# Reading payment slips: a customer's image becomes a payment to check only when
# Claude finds a paid amount on it (src/lib/receipt-vision.ts). Set as a Worker
# secret: `wrangler secret put ANTHROPIC_API_KEY`. Left empty, every image becomes
# a blank payment to check, as before.
ANTHROPIC_API_KEY=
